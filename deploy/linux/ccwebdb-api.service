# The API, started at boot after the database, restarted if it fails.
#
# A template: render it from backend/ with
#     python -m app.runtime_settings --render ../deploy/linux/ccwebdb-api.service
# and install the result as /etc/systemd/system/ccwebdb-api.service
# (docs/deployment-linux.md). The API reads the repository's .env itself,
# so the unit names no environment file. It listens on CCWEB_API_HOST only,
# behind Caddy: --proxy-headers with --forwarded-allow-ips set to that
# address makes it see each visitor's address in Caddy's X-Forwarded-For,
# which the sign-in limits count by, and believe no one else's. Its log
# goes to the journal: journalctl -u ccwebdb-api.
#
# Hardening: the whole file system is read-only to the API but the
# photographs' folder, the log folder and .runtime, each of which must
# exist before the unit starts; it gets a private /tmp and a /dev of
# pseudo-devices only, can gain no privilege or capability, can open only
# network and local sockets, sees no other process in /proc, and can change
# neither the clock, the host name, the kernel's settings and logs nor a
# namespace. None of it is anything the API does.
# ProtectHome is left off: true would hide the repository and the conda
# environment, which live in the owner's home folder and which the API must
# read, and read-only would add nothing ProtectSystem=strict does not
# already do.
[Unit]
Description=ccwebdb API (FastAPI under uvicorn)
After=network.target ccwebdb-postgres.service
Wants=ccwebdb-postgres.service

[Service]
User=@CCWEB_USER@
WorkingDirectory=@CCWEB_REPO@/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=@CCWEB_ENV_DIR@/bin/python -m uvicorn app.main:app --host @CCWEB_API_HOST@ --port @CCWEB_API_PORT@ --proxy-headers --forwarded-allow-ips @CCWEB_API_HOST@
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@MEDIA_ROOT@ @CCWEB_LOG_DIR@ @CCWEB_RUNTIME_DIR@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
